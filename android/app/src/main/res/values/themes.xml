<resources>
    <style name="Theme.Callback" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:buttonStyle">@style/Widget.Callback.Button</item>
        <item name="buttonStyle">@style/Widget.Callback.Button</item>
    </style>

    <style name="Widget.Callback.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/btn_rounded</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
