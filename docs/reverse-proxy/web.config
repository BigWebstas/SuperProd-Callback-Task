<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- Requires ARR installed with its proxy feature enabled server-wide —
         see README.md in this folder; this element alone won't turn it on
         if IIS locks system.webServer/proxy. -->
    <proxy enabled="true" preserveHostHeader="false" reverseRewriteHostInResponseHeaders="false" />

    <rewrite>
      <rules>
        <rule name="ReverseProxyToSuperProductivity" stopProcessing="true">
          <match url="(.*)" />
          <!-- Target host is the literal string "localhost", not 127.0.0.1.
               With preserveHostHeader="false", ARR sets the outbound Host
               header from this URL's authority — so using "localhost" here
               satisfies Super Productivity's Host: localhost guard with no
               server-variable override needed. -->
          <action type="Rewrite" url="http://localhost:3876/{R:1}" logRewrittenUrl="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
